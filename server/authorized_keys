# /srv/fdroid/.ssh/authorized_keys  (chown fdroid:fdroid, chmod 600)
#
# The restriction is the point. A bare public key here grants a full shell as
# the fdroid user; with this prefix the key can do exactly one thing, rsync
# into /srv/fdroid/www, with no shell, no port forwarding and no agent.
#
# Read and write, not rrsync -wo: the publish job pulls the repo down before
# regenerating the index.
command="rrsync /srv/fdroid/www",restrict ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIJJYHbb61gUXRVcrcLWvAkbO5aLJn16ZC3lhlhm7bsyy dev@desktop
